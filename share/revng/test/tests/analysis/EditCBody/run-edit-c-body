set -euo pipefail

# Exercise the edit-c-body analysis end to end. The test functions decompile to a
# fixed, well-known shape, so each directive is placed by anchoring on a literal
# name the decompiler is guaranteed to produce.
#
# In `irreducible`, every directive is expected to land:
#
#   - `var_0`       the first local variable declaration -> RENAME + RETYPE
#                                                          + a comment;
#   - `label_0`     the goto label                       -> RENAME + a comment;
#   - `goto label_0;` a jump                             -> a comment;
#   - `var_2 = 0`   a plain assignment statement          -> a statement comment.
#
# Where a comment lands depends on what it sits above. A declaration and a goto
# label own a comment, so theirs go to the `LocalVariable` and the `GotoLabel`;
# a jump and an assignment do not, so theirs stay statement comments.
#
# Each directive is then checked to reach the model and, where the decompiler
# renders it, the re-emitted code.
#
# The rest covers the annotations that cannot be applied. Those are dropped and
# reported on the `edit-c-body` logger, one at a time, leaving every other
# annotation in the same function alone: `RENAME:` only applies to a local
# variable declaration, so the one placed on the `var_2` assignment is dropped,
# while the plain comment on that very same statement still lands.

BINARY="$1"
PROJECT="$2"
FUNCTION="irreducible"

# A `RENAME:` that cannot be applied, placed on an assignment.
DROPPED_RENAME="not_a_declaration"

# Comments on the statements that are located indirectly: a goto label, through
# the statements jumping to it, and a jump, through its own branch instruction.
LABEL_COMMENT="A comment on a goto label."
GOTO_COMMENT="A comment on a goto."
DECL_COMMENT="A comment on a local variable declaration."

fail() {
  echo "edit-c-body: $1" >&2
  exit 1
}

# Read a value out of a function's model with yq.
function_model() {
  yq ".Functions[] | select(.Name == \"$1\") | $2" "$PROJECT/revng.yml"
}

# Assert a model query on a function returns an expected value.
assert_model() {
  [ "$(function_model "$1" "$2")" = "$3" ] || fail "$4"
}

# Assert the re-emitted C contains a string.
assert_reemitted() {
  grep -qF "$1" <<< "$REEMIT" || fail "re-emitted code is missing: $1"
}

# Copy a decompiled function inserting a `//` line before the first line holding
# each anchor. Takes the source, the target, then anchor/directive pairs.
insert_directives() {
  python3 - "$@" <<'PYEOF'
import sys

source, target = sys.argv[1], sys.argv[2]
pairs = sys.argv[3:]
lines = open(source).read().split("\n")

for anchor, directive in zip(pairs[::2], pairs[1::2]):
    for index, line in enumerate(lines):
        if anchor in line:
            indent = line[:len(line) - len(line.lstrip())]
            lines.insert(index, indent + "// " + directive)
            break
    else:
        sys.exit("anchor not found in the decompiled code: " + anchor)

open(target, "w").write("\n".join(lines) + "\n")
PYEOF
}

# Wrap an edited function into an edit-c-body configuration. The configuration
# needs the function's entry address; read it from the model.
make_configuration() {
  local address
  address="$(function_model "$1" '.Entry' | tr -d '"')"
  if [ -z "$address" ] || [ "$address" = "null" ]; then
    fail "could not find the entry address of $1"
  fi

  {
    echo "Function: $address"
    echo "CCode: |"
    sed 's/^/  /' "$2"
  } > "$3"
}

# Run the analysis with the `edit-c-body` logger on, keeping its report of the
# annotations that could not be applied.
analyze() {
  revng -C "$PROJECT" project analyze edit-c-body -o /dev/null \
    -c "$1" -- --debug-log=edit-c-body 2>&1 \
    | tee "$2"
}

mkdir -p "$PROJECT"
revng -C "$PROJECT" project init --overwrite "$BINARY"

# The decompiled C, produced live.
revng -C "$PROJECT" project artifact emit-c "$FUNCTION" | revng ptml > "$PROJECT/live.c"

# Insert one directive of each kind before its anchor line.
insert_directives "$PROJECT/live.c" "$PROJECT/edited.c" \
  "var_0" "RENAME: renamed_local" \
  "var_0" "RETYPE: uint32_t" \
  "var_0" "$DECL_COMMENT" \
  "label_0:" "RENAME: renamed_goto_label" \
  "label_0:" "$LABEL_COMMENT" \
  "goto label_0;" "$GOTO_COMMENT" \
  "var_2 = 0" "RENAME: $DROPPED_RENAME" \
  "var_2 = 0" "A plain comment on a statement."

make_configuration "$FUNCTION" "$PROJECT/edited.c" "$PROJECT/edit.yml"

analyze "$PROJECT/edit.yml" "$PROJECT/analyze.log"

# The comment, both renames and the retype must reach the model. A rename-only
# variable has no `Type`, so `renamed_local` carrying a 4-byte type (uint32_t)
# proves the retype landed.
assert_model "$FUNCTION" \
  '[.Comments[] | select(.Body == "A plain comment on a statement.")] | length' 1 \
  "the statement comment did not reach the model"
assert_model "$FUNCTION" \
  '[.LocalVariables[] | select(.Name == "renamed_local")] | length' 1 \
  "the local variable rename did not reach the model"
assert_model "$FUNCTION" \
  '.LocalVariables[] | select(.Name == "renamed_local") | .Type.Size' 4 \
  "the local variable retype did not reach the model"
assert_model "$FUNCTION" \
  '[.GotoLabels[] | select(.Name == "renamed_goto_label")] | length' 1 \
  "the goto label rename did not reach the model"

# A goto label owns its comment, so the comment above it becomes the label's
# rather than one attached to a point in the code. Only its arrival in the model
# is checked: statements lifted from the same instruction share an address set,
# and the emitter is then free to render the comment on any one of them.
assert_model "$FUNCTION" \
  "[.GotoLabels[] | select(.Comment == \"$LABEL_COMMENT\")] | length" 1 \
  "the comment on the goto label did not become the label's comment"

# A jump owns nothing, so a comment above one stays a statement comment.
assert_model "$FUNCTION" \
  "[.Comments[] | select(.Body == \"$GOTO_COMMENT\")] | length" 1 \
  "the comment on the goto did not reach the model"

# A declaration is located through the statements using the variable, exactly
# like the `RENAME:` and the `RETYPE:` sitting on it, so all three apply at
# once, the comment landing on the variable itself.
assert_model "$FUNCTION" \
  "[.LocalVariables[] | select(.Comment == \"$DECL_COMMENT\")] | length" 1 \
  "the comment on the declaration did not become the variable's comment"

# Neither of the two became a statement comment, which is what would show up
# twice in the re-emitted code.
assert_model "$FUNCTION" \
  "[.Comments[] | select(.Body == \"$DECL_COMMENT\" or .Body == \"$LABEL_COMMENT\")] | length" 0 \
  "a comment owned by an entity was also recorded as a statement comment"

# The `RENAME:` on the assignment cannot be applied. It must be dropped rather
# than abort the import, be reported on the logger, and leave the plain comment
# on that same statement, asserted above, alone.
grep -qF "Ignoring \`RENAME\` on an expression statement" "$PROJECT/analyze.log" \
  || fail "a directive that cannot be applied was not reported on the logger"
assert_model "$FUNCTION" \
  "[.LocalVariables[] | select(.Name == \"$DROPPED_RENAME\")] | length" 0 \
  "a directive that cannot be applied reached the model"

# The renames and the comment round-trip back into the re-emitted code (a type
# change is model-only and does not reach emit-c, so it is not checked here).
REEMIT="$(revng -C "$PROJECT" project artifact emit-c "$FUNCTION" | revng ptml)"
assert_reemitted "A plain comment on a statement."
assert_reemitted "renamed_local"
assert_reemitted "renamed_goto_label:"
