set -euo pipefail

# Exercise the edit-c-body analysis end to end. The test functions decompile to a
# fixed, well-known shape, so each directive is placed by anchoring on a literal
# name the decompiler is guaranteed to produce.
#
# In `irreducible`, every directive is expected to land:
#
#   - `var_0`       the first local variable declaration -> RENAME + RETYPE;
#   - `label_0`     the goto label                       -> RENAME;
#   - `var_2 = 0`   a plain assignment statement          -> a statement comment.
#
# Each is then checked to reach the model and, where the decompiler renders it,
# the re-emitted code.

BINARY="$1"
PROJECT="$2"
FUNCTION="irreducible"

fail() {
  echo "edit-c-body: $1" >&2
  exit 1
}

# Read a value out of a function's model with yq.
function_model() {
  yq ".Functions[] | select(.Name == \"$1\") | $2" "$PROJECT/revng.yml"
}

# Assert a model query on a function returns an expected value.
assert_model() {
  [ "$(function_model "$1" "$2")" = "$3" ] || fail "$4"
}

# Assert the re-emitted C contains a string.
assert_reemitted() {
  grep -qF "$1" <<< "$REEMIT" || fail "re-emitted code is missing: $1"
}

# Copy a decompiled function inserting a `//` line before the first line holding
# each anchor. Takes the source, the target, then anchor/directive pairs.
insert_directives() {
  python3 - "$@" <<'PYEOF'
import sys

source, target = sys.argv[1], sys.argv[2]
pairs = sys.argv[3:]
lines = open(source).read().split("\n")

for anchor, directive in zip(pairs[::2], pairs[1::2]):
    for index, line in enumerate(lines):
        if anchor in line:
            indent = line[:len(line) - len(line.lstrip())]
            lines.insert(index, indent + "// " + directive)
            break
    else:
        sys.exit("anchor not found in the decompiled code: " + anchor)

open(target, "w").write("\n".join(lines) + "\n")
PYEOF
}

# Wrap an edited function into an edit-c-body configuration. The configuration
# needs the function's entry address; read it from the model.
make_configuration() {
  local address
  address="$(function_model "$1" '.Entry' | tr -d '"')"
  if [ -z "$address" ] || [ "$address" = "null" ]; then
    fail "could not find the entry address of $1"
  fi

  {
    echo "Function: $address"
    echo "CCode: |"
    sed 's/^/  /' "$2"
  } > "$3"
}

mkdir -p "$PROJECT"
revng -C "$PROJECT" project init --overwrite "$BINARY"

# The decompiled C, produced live.
revng -C "$PROJECT" project artifact emit-c "$FUNCTION" | revng ptml > "$PROJECT/live.c"

# Insert one directive of each kind before its anchor line.
insert_directives "$PROJECT/live.c" "$PROJECT/edited.c" \
  "var_0" "RENAME: renamed_local" \
  "var_0" "RETYPE: uint32_t" \
  "label_0:" "RENAME: renamed_goto_label" \
  "var_2 = 0" "A plain comment on a statement."

make_configuration "$FUNCTION" "$PROJECT/edited.c" "$PROJECT/edit.yml"

revng -C "$PROJECT" project analyze edit-c-body -o /dev/null -c "$PROJECT/edit.yml"

# The comment, both renames and the retype must reach the model. A rename-only
# variable has no `Type`, so `renamed_local` carrying a 4-byte type (uint32_t)
# proves the retype landed.
assert_model "$FUNCTION" \
  '[.Comments[] | select(.Body == "A plain comment on a statement.")] | length' 1 \
  "the statement comment did not reach the model"
assert_model "$FUNCTION" \
  '[.LocalVariables[] | select(.Name == "renamed_local")] | length' 1 \
  "the local variable rename did not reach the model"
assert_model "$FUNCTION" \
  '.LocalVariables[] | select(.Name == "renamed_local") | .Type.Size' 4 \
  "the local variable retype did not reach the model"
assert_model "$FUNCTION" \
  '[.GotoLabels[] | select(.Name == "renamed_goto_label")] | length' 1 \
  "the goto label rename did not reach the model"

# The renames and the comment round-trip back into the re-emitted code (a type
# change is model-only and does not reach emit-c, so it is not checked here).
REEMIT="$(revng -C "$PROJECT" project artifact emit-c "$FUNCTION" | revng ptml)"
assert_reemitted "A plain comment on a statement."
assert_reemitted "renamed_local"
assert_reemitted "renamed_goto_label:"

